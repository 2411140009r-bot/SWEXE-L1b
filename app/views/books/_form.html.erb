<%= form_with(model: book) do |f| %>
  <% if book.errors.any? %>
    <div class="error-box">
      <strong><%= book.errors.count %> 件のエラーが発生しました：</strong>
      <ul>
        <% book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>

  <div class="form-group">
    <%= f.label :author, "著者" %>
    <%= f.text_field :author %>
  </div>

  <div class="form-group">
    <%= f.label :price, "価格（円）" %>
    <%= f.number_field :price %>
  </div>

  <div class="actions">
    <%= f.submit class: "btn" %>
  </div>
<% end %>