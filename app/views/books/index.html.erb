<div style="display: flex; justify-content: space-between; align-items: center;">
  <h1>書籍一覧</h1>
  <%= link_to "＋ 新規登録", new_book_path, class: "btn" %>
</div>

<table>
  <thead>
    <tr>
      <th>タイトル</th>
      <th>著者</th>
      <th>価格</th>
      <th style="width: 160px;">操作</th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.author %></td>
        <td><%= number_with_delimiter(book.price) %> 円</td>
        <td>
          <%= link_to "詳細", book_path(book) %> |
          <%= link_to "編集", edit_book_path(book) %> |
          <%= link_to "削除", book_path(book), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, style: "color: #d9534f;" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>