<h1>書籍一覧</h1>
<p><%= flash[:notice] %></p>

<%= link_to "新規登録", new_book_path %>

<table border="1" style="margin-top: 10px;">
  <thead>
    <tr>
      <th>タイトル</th>
      <th>著者</th>
      <th>価格</th>
      <th colspan="3">操作</th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.author %></td>
        <td><%= book.price %>円</td>
        <td><%= link_to "詳細", book_path(book) %></td>
        <td><%= link_to "編集", edit_book_path(book) %></td>
        <td><%= link_to "削除", book_path(book), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>