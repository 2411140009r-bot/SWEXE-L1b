<h1>書籍詳細</h1>

<div style="background: #fff; padding: 20px; border: 1px solid #eee; border-radius: 4px; margin-bottom: 20px;">
  <p><strong>タイトル:</strong> <%= @book.title %></p>
  <p><strong>著者:</strong> <%= @book.author %></p>
  <p><strong>価格:</strong> <%= number_with_delimiter(@book.price) %> 円</p>
</div>

<div class="actions">
  <%= link_to "編集", edit_book_path(@book), class: "btn" %>
  <%= link_to "一覧に戻る", books_path, class: "btn btn-secondary" %>
</div>