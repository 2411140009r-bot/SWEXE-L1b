<!DOCTYPE html>
<html>
  <head>
    <title>書籍管理アプリ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        max-width: 800px;
        margin: 40px auto;
        padding: 0 20px;
        color: #333;
        background-color: #fcfcfc;
      }
      h1 { border-bottom: 2px solid #333; padding-bottom: 8px; margin-bottom: 20px; }
      a { color: #0066cc; text-decoration: none; }
      a:hover { text-decoration: underline; }

      /* ボタン */
      .btn {
        display: inline-block;
        padding: 8px 16px;
        background-color: #0066cc;
        color: #fff;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-size: 14px;
      }
      .btn:hover { background-color: #0052a3; text-decoration: none; color: #fff; }
      .btn-secondary { background-color: #6c757d; }
      .btn-secondary:hover { background-color: #5a6268; }

      /* フラッシュメッセージ */
      .flash-notice {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        padding: 12px 16px;
        border-radius: 4px;
        margin-bottom: 20px;
      }

      /* エラーボックス */
      .error-box {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        padding: 15px;
        border-radius: 4px;
        margin-bottom: 20px;
      }
      .error-box ul { margin: 8px 0 0 20px; padding: 0; }

      /* テーブル */
      table { width: 100%; border-collapse: collapse; margin-top: 15px; background: #fff; }
      th, td { padding: 12px; border-bottom: 1px solid #eee; text-align: left; }
      th { background-color: #f4f5f7; }

      /* フォーム */
      .form-group { margin-bottom: 16px; }
      .form-group label { display: block; font-weight: bold; margin-bottom: 6px; }
      .form-group input {
        width: 100%;
        padding: 8px 12px;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 14px;
      }
      .actions { display: flex; gap: 10px; align-items: center; margin-top: 24px; }
    </style>
  </head>
  <body>
    <% if flash[:notice] %>
      <div class="flash-notice"><%= flash[:notice] %></div>
    <% end %>
    <%= yield %>
  </body>
</html>